#!/bin/sh
# PROC-4 (Orchestrator/AuditLab, 2026-10-21/22): only the scheduled reverify job ran
# preship_gate.py before this -- a hand commit+push had nothing on either the commit or
# push path, the exact gap that let b58ab9aac ship 259 pages with literal
# `<<<<<<<`/`=======`/`>>>>>>>` merge-conflict markers baked into their cache-buster
# line. This runs the gate on push (commit-msg only checks attribution, see ATTR-5 --
# it does NOT run this gate, so a hand commit is still ungated until push).
# Install: git config core.hooksPath scripts/git-hooks   (run once per clone/worktree)

cat >/dev/null  # drain stdin (the pushed ref list); the gate checks repo state, not which refs moved

repo_root="$(git rev-parse --show-toplevel)" || exit 1
cd "$repo_root" || exit 1
# PROC-19 (2026-11-03): git exports GIT_DIR & co. into hooks. Inherited by pytest, they pointed
# every test's temp-repo `git init/config/commit/push` at THIS repo: the first real push through
# the PROC-18 limb set core.bare=true, hijacked core.hooksPath and user.name in the shared config,
# and committed test trees onto the pushing worktree's HEAD. Clear them (scripts/conftest.py does
# too); both commands below run from repo_root and rediscover the repo from cwd.
unset $(git rev-parse --local-env-vars)

py="$(command -v python3 || command -v python)"
if [ -z "$py" ]; then
  echo "REJECTED: no python3/python found on PATH -- cannot run preship_gate.py (PROC-4)." >&2
  exit 1
fi

# PROC-18 (AuditLab, 2026-11-03): the test suite's only runner was gate #1 of the nightly
# reverify job, so 830376007 pushed a stale LB-7 assertion and the 11-03 run failed with no
# data deploy (one staleness day burned). Same invocation as scripts/reverify/job.py, run
# first so a push fails exactly where the nightly job would. ~95s.
"$py" -m pytest scripts/reverify scripts -q
rc=$?
if [ "$rc" -ne 0 ]; then
  echo "REJECTED: pytest scripts/reverify scripts failed (rc=$rc) -- push blocked (PROC-18)." >&2
  exit 1
fi

"$py" scripts/preship_gate.py
rc=$?
if [ "$rc" -ne 0 ]; then
  echo "REJECTED: scripts/preship_gate.py failed (rc=$rc) -- push blocked (PROC-4)." >&2
  exit 1
fi
exit 0
